# PostgreSQL connection string (use a managed PostgreSQL database in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fusion_music

# Twitch broadcaster account ID (the one Fusion channel this service belongs to)
TWITCH_BROADCASTER_ID=

# Twitch developer application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Public base URL of this deployment
APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# Keep this value private and stable; changing it invalidates stored encrypted Twitch tokens.
TOKEN_ENCRYPTION_KEY=

# Set to production on hosted deployments
NODE_ENV=development
