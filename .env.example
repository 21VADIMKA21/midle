# PostgreSQL connection string (use a managed PostgreSQL database in production)
DATABASE_URL=postgresql://fusion_music:local_dev_password@localhost:5432/fusion_music

# Twitch developer application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional public base URL; defaults to the request origin
APP_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# Keep this value private and stable; changing it invalidates stored encrypted Twitch tokens.
TOKEN_ENCRYPTION_KEY=

# Set to production on hosted deployments
NODE_ENV=development
